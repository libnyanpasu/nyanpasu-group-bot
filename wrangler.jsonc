{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nyanpasu-group-bot",
  "main": "dist/worker.js",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nyanpasu-group-bot",
      "database_id": "84215c69-929a-4602-98ca-141b357868bb",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
  // Default for groups that have not run /verify_config deleteJoinMessages=on|off.
  "vars": { "DELETE_JOIN_MESSAGES": "false" },
}
