{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nyanpasu-group-bot",
  "main": "dist/worker.js",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  // One timer per verification session wakes maintenance at its due time; cron is the backstop.
  "durable_objects": { "bindings": [{ "name": "SESSION_TIMER", "class_name": "SessionTimer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionTimer"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nyanpasu-group-bot",
      "database_id": "84215c69-929a-4602-98ca-141b357868bb",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
  // Default for groups that have not run /verify_config deleteJoinMessages=on|off.
  // Spam filter defaults for groups without their own /verify_config spam* settings.
  "vars": {
    "DELETE_JOIN_MESSAGES": "false",
    "SPAM_MODE": "off",
    "SPAM_FIRST_MESSAGES": "3",
    "SPAM_BAN": "true",
    "SPAM_CAS": "true",
  },
}
