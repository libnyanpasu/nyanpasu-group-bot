{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "验证题库清单",
  "description": "声明一个私有题库包含哪些题目分类，以及需要展示的群规文件。题目按 questions/<type>/<question-id>.json 分类存放；题库文件名使用 id。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "questionTypes", "rules"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "可选的题库清单 schema 标识。"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "题库稳定 ID，同时作为题库文件名。"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S",
      "description": "题库内容版本；可使用日期、语义版本或其他非空文本。"
    },
    "questionTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "此题库采用的题目分类目录，例如 networking、windows。",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "rules": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "关联的群规文件 ID；该 ID 使用 slug 格式。"
    }
  }
}
