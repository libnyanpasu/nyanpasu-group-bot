BOT_TOKEN=replace_with_botfather_bot_api_token
WEBHOOK_SECRET=replace_with_a_random_url_safe_secret
# Optional: delete "joined the group" messages in groups without their own setting.
DELETE_JOIN_MESSAGES=false
# Optional spam filter defaults for groups without their own setting.
SPAM_MODE=off
SPAM_FIRST_MESSAGES=3
SPAM_BAN=true
SPAM_CAS=true
